{
    "id": null,
    "title": "Dashboard de Logs y M\u00e9tricas Docker",
    "timezone": "browser",
    "schemaVersion": 30,
    "version": 1,
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "type": "logs",
        "title": "Visor de Logs por contenedor",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "expr": "{container_name=~\".+\"}",
            "refId": "A"
          }
        ],
        "id": 1,
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 12
        }
      },
      {
        "type": "timeseries",
        "title": "N\u00famero de l\u00edneas de log por contenedor (\u00faltima hora)",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "expr": "count_over_time({container_name=~\".+\"}[1m])",
            "refId": "B"
          }
        ],
        "id": 2,
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": {
              "mode": "palette-classic"
            },
            "custom": {}
          },
          "overrides": []
        }
      },
      {
        "type": "stat",
        "title": "Errores recientes (contiene 'error')",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "targets": [
          {
            "expr": "count_over_time({container_name=~\".+\"} |= \"error\"[5m])",
            "refId": "C"
          }
        ],
        "id": 3,
        "gridPos": {
          "x": 12,
          "y": 12,
          "w": 12,
          "h": 8
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "color": {
              "mode": "thresholds"
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 10
                },
                {
                  "color": "red",
                  "value": 50
                }
              ]
            },
            "custom": {}
          },
          "overrides": []
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "templating": {
      "list": []
    }
  }