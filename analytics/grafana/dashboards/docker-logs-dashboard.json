{
  "id": null,
  "uid": "unified-logs-metrics-dashboard",
  "title": "Unified Logs & Metrics Dashboard",
  "timezone": "browser",
  "schemaVersion": 37,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "logs",
      "title": "Visor de Logs por contenedor",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{container_name=~\".+\"}",
          "refId": "A"
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      }
    },
    {
      "type": "timeseries",
      "title": "N\u00famero de l\u00edneas de log por contenedor (\u00faltima hora)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "count_over_time({container_name=~\".+\"}[1m])",
          "refId": "B"
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Errores recientes (contiene 'error')",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "count_over_time({container_name=~\".+\"} |= \"error\"[5m])",
          "refId": "C"
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 6,
        "h": 4
      },
      "id": 4,
      "targets": [
        {
          "expr": "gateway_requests_total",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "Average Request Duration (s)",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 20,
        "w": 12,
        "h": 4
      },
      "id": 5,
      "targets": [
        {
          "expr": "rate(gateway_request_duration_seconds_sum[1m]) / rate(gateway_request_duration_seconds_count[1m])",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "Request Duration Heatmap",
      "type": "heatmap",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 18,
        "h": 8
      },
      "id": 6,
      "targets": [
        {
          "expr": "gateway_request_duration_seconds_bucket",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "Requests by Status Code",
      "type": "barchart",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 4
      },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (status_code) (rate(gateway_status_codes_total[1m]))",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "CPU Usage (Rate)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 4
      },
      "id": 8,
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total[1m])",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "Memory Usage (Resident)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 4
      },
      "id": 9,
      "targets": [
        {
          "expr": "process_resident_memory_bytes",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "Open File Descriptors",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 6,
        "h": 4
      },
      "id": 10,
      "targets": [
        {
          "expr": "process_open_fds",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "GC Collections (gen=0)",
      "type": "timeseries",
      "gridPos": {
        "x": 6,
        "y": 40,
        "w": 6,
        "h": 4
      },
      "id": 11,
      "targets": [
        {
          "expr": "rate(python_gc_collections_total{generation=\"0\"}[5m])",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    },
    {
      "title": "GC Collected Objects (gen=0)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 6,
        "h": 4
      },
      "id": 12,
      "targets": [
        {
          "expr": "rate(python_gc_objects_collected_total{generation=\"0\"}[5m])",
          "refId": "A"
        }
      ],
      "datasource": "Prometheus"
    }
  ]
}