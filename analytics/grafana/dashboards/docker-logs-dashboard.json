{
  "dashboard": {
    "id": null,
    "uid": null,
    "title": "Docker Logs",
    "timezone": "browser",
    "schemaVersion": 37,
    "version": 1,
    "refresh": "5s",
    "time": {
      "from": "now-30m",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m"
      ],
      "time_options": [
        "5m",
        "15m",
        "30m",
        "1h",
        "6h",
        "12h",
        "24h"
      ]
    },
    "templating": {
      "list": []
    },
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "panels": [
      {
        "title": "Total Requests",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 4
        },
        "id": 1,
        "targets": [
          {
            "expr": "gateway_requests_total",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "title": "Average Request Duration (s)",
        "type": "timeseries",
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 12,
          "h": 4
        },
        "id": 2,
        "targets": [
          {
            "expr": "rate(gateway_request_duration_seconds_sum[1m]) / rate(gateway_request_duration_seconds_count[1m])",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "title": "Request Duration Heatmap",
        "type": "heatmap",
        "gridPos": {
          "x": 0,
          "y": 4,
          "w": 18,
          "h": 8
        },
        "id": 3,
        "targets": [
          {
            "expr": "gateway_request_duration_seconds_bucket",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "title": "Requests by Status Code",
        "type": "barchart",
        "gridPos": {
          "x": 0,
          "y": 12,
          "w": 12,
          "h": 4
        },
        "id": 4,
        "targets": [
          {
            "expr": "sum by (status_code) (rate(gateway_status_codes_total[1m]))",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "title": "CPU Usage (Rate)",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 4
        },
        "id": 5,
        "targets": [
          {
            "expr": "rate(process_cpu_seconds_total[1m])",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "title": "Memory Usage (Resident)",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 4
        },
        "id": 6,
        "targets": [
          {
            "expr": "process_resident_memory_bytes",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "title": "Open File Descriptors",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 6,
          "h": 4
        },
        "id": 7,
        "targets": [
          {
            "expr": "process_open_fds",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "title": "GC Collections (gen=0)",
        "type": "timeseries",
        "gridPos": {
          "x": 6,
          "y": 20,
          "w": 6,
          "h": 4
        },
        "id": 8,
        "targets": [
          {
            "expr": "rate(python_gc_collections_total{generation=\"0\"}[5m])",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      },
      {
        "title": "GC Collected Objects (gen=0)",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 20,
          "w": 6,
          "h": 4
        },
        "id": 9,
        "targets": [
          {
            "expr": "rate(python_gc_objects_collected_total{generation=\"0\"}[5m])",
            "refId": "A"
          }
        ],
        "datasource": "Prometheus"
      }
    ],
    "gridPos": {
      "h": 0,
      "w": 24,
      "x": 0,
      "y": 0
    }
  },
  "overwrite": true
}